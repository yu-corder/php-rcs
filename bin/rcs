#!/usr/bin/env php
<?php
require_once __DIR__ . '/../vendor/autoload.php';

use YuCorder\RcsManager;

$rcs = new RcsManager();

if ($argc < 2) {
    showHelp();
    exit(1);
}

$command = $argv[1];

try {
    switch ($command) {
        case 'checkin':
            $file = $argv[2] ?? null;
            $comment = $argv[3] ?? 'No comment';
            if (!$file) {
                echo "Error: Missing required argument <filename>.\n";
                exit(1);
            }
            $rcs->checkIn($file, $comment);
            echo "✓ Successfully checked in.\n";
            break;

        case 'checkout':
            $file = $argv[2] ?? null;
            $version = isset($argv[3]) ? (int)$argv[3] : null;
            
            if (!$file || $version === null) {
                echo "Error: Missing required arguments <filename> or <version>.\n";
                exit(1);
            }
            
            $rcs->checkOut($file, $version);
            echo "✓ Successfully checked out to v{$version}.\n";
            break;
        
        case 'log':
            $file = $argv[2] ?? null;
            $version = isset($argv[3]) ? (int)$argv[3] : null;

            if (!$file) {
                echo "Error: Missing required argument <filename>.\n";
                exit(1);
            }

            $history = $rcs->log($file, $version);
            foreach ($history as $item) {
                echo "v{$item['version']} | {$item['date']} | {$item['comment']}\n";
            }
            break;
        
        default:
            echo "Error: Unknown command '{$argv[1]}'.\n";
            showHelp();
            exit(1);
    }
} catch (\Exception $e) {
    echo("Error: " . $e->getMessage() . "\n");
    exit(1);
}

function showHelp(): void {
    echo "Usage:\n";
    echo " php bin/rcs checkIn <filename> [<comment>]\n";
    echo " php bin/rcs checkout <filename> <version>\n";
    echo " php bin/rcs log <filename>\n";
}