#!/usr/bin/env php
<?php
declare(strict_types=1);
if (file_exists(__DIR__ . '/../../../autoload.php')) {
    require_once __DIR__ . '/../../../autoload.php';
} else {
    require_once __DIR__ . '/../vendor/autoload.php';
}

use YuCorder\RcsManager;

$rcs = new RcsManager();

if ($argc < 2) {
    showHelp();
    exit(1);
}

$command = strtolower($argv[1]);

try {
    switch ($command) {
        case 'checkin':
            $file = $argv[2] ?? null;
            $comment = $argv[3] ?? 'No comment';
            if (!$file) {
                file_put_contents('php://stderr', "Error: Missing required argument <filename>.\n");
                exit(1);
            }
            $rcs->checkIn($file, $comment);
            echo "✓ Successfully checked in.\n";
            break;

        case 'checkout':
            $file = $argv[2] ?? null;
            $version = isset($argv[3]) ? (int)$argv[3] : null;
            
            if (!$file || $version === null) {
                file_put_contents('php://stderr', "Error: Missing required arguments <filename> or <version>.\n");
                exit(1);
            }
            
            $rcs->checkOut($file, $version);
            echo "✓ Successfully checked out to v{$version}.\n";
            break;
        
        case 'log':
            $file = $argv[2] ?? null;
            $version = isset($argv[3]) ? (int)$argv[3] : null;

            if (!$file) {
                file_put_contents('php://stderr', "Error: Missing required argument <filename>.\n");
                exit(1);
            }

            $history = $rcs->log($file, $version);
            foreach ($history as $item) {
                echo "v{$item['version']} | {$item['date']} | {$item['comment']}\n";
            }
            break;
        
        default:
            file_put_contents('php://stderr', "Error: Unknown command '{$argv[1]}'.\n");
            showHelp();
            exit(1);
    }
} catch (\Exception $e) {
    file_put_contents('php://stderr', "Error: " . $e->getMessage() . "\n");
    exit(1);
}

function showHelp(): void {
    $help = "Usage:\n"
        ." php bin/rcs checkin <filename> [<comment>]\n"
        ." php bin/rcs checkout <filename> <version>\n"
        ." php bin/rcs log <filename> [<version>]\n";

    file_put_contents('php://stderr', $help);
}